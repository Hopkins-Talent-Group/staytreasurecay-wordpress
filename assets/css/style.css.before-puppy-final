:root{
    --teal:#087b86;
    --teal-dark:#073f46;
    --deep:#062f35;
    --cream:#f8f6f0;
    --sand:#eee8dc;
    --white:#ffffff;
    --text:#173e43;
    --muted:#647477;
    --line:#d9dfdb;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"DM Sans",Arial,sans-serif;
    color:var(--text);
    background:var(--cream);
    line-height:1.65;
}

a{
    color:inherit;
    text-decoration:none;
}

img,
video{
    display:block;
    width:100%;
}

button{
    font:inherit;
}

.section-container{
    width:min(1180px,calc(100% - 48px));
    margin:auto;
}

.section{
    padding:120px 0;
}

.eyebrow{
    font-size:11px;
    font-weight:700;
    letter-spacing:3px;
    color:var(--teal);
}

#site-header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    padding:20px 42px;
    color:#fff;
    transition:.3s ease;
}

#site-header.scrolled{
    background:rgba(6,47,53,.94);
    backdrop-filter:blur(14px);
    padding:14px 42px;
}

.header-inner{
    max-width:1380px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.brand{
    display:flex;
    flex-direction:column;
    line-height:1;
    color:#fff;
}

.brand-top{
    font-size:9px;
    letter-spacing:5px;
}

.brand-main{
    font-family:"Playfair Display",serif;
    font-size:20px;
    letter-spacing:1px;
}

.brand-location{
    font-size:7px;
    letter-spacing:3px;
    margin-top:4px;
    opacity:.8;
}

.desktop-nav{
    display:flex;
    gap:34px;
    align-items:center;
}

.desktop-nav a{
    font-size:13px;
    font-weight:600;
    transition:.2s;
}

.desktop-nav a:hover{
    opacity:.65;
}

.header-book{
    background:#fff;
    color:var(--deep);
    padding:12px 22px;
    font-size:12px;
    font-weight:700;
    letter-spacing:.5px;
}

.menu-toggle{
    display:none;
    border:0;
    background:transparent;
    cursor:pointer;
}

.menu-toggle span{
    display:block;
    width:25px;
    height:2px;
    background:#fff;
    margin:5px 0;
}

.mobile-menu{
    display:none;
}


/* HERO */

.hero{
    position:relative;
    min-height:100vh;
    color:#fff;
    display:flex;
    align-items:center;
    overflow:hidden;
}

.hero-video{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
}

.hero-overlay{
    position:absolute;
    inset:0;
    background:
        linear-gradient(90deg,rgba(2,25,31,.78),rgba(2,25,31,.25) 65%,rgba(2,25,31,.12)),
        linear-gradient(0deg,rgba(2,25,31,.55),transparent 45%);
}

.hero-content{
    position:relative;
    z-index:2;
    width:min(1180px,calc(100% - 48px));
    margin:auto;
    padding-top:90px;
}

.hero-kicker{
    font-size:12px;
    letter-spacing:3px;
    font-weight:700;
    color:#31c0ca;
    margin-bottom:20px;
}

.hero h1{
    font-family:"Playfair Display",serif;
    font-size:clamp(58px,7vw,100px);
    font-weight:500;
    line-height:.94;
    max-width:800px;
    margin-bottom:25px;
}

.hero h1 em{
    color:#34c0c7;
}

.hero-description{
    max-width:500px;
    font-size:17px;
    line-height:1.6;
    margin-bottom:30px;
}

.hero-actions{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
}

.btn{
    display:inline-flex;
    justify-content:center;
    align-items:center;
    min-width:175px;
    padding:15px 24px;
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.8px;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-primary{
    background:var(--teal);
    color:#fff;
}

.btn-outline{
    border:1px solid rgba(255,255,255,.75);
    color:#fff;
}

.hero-highlights{
    position:absolute;
    z-index:2;
    left:50%;
    bottom:32px;
    transform:translateX(-50%);
    width:min(1180px,calc(100% - 48px));
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:30px;
    color:#fff;
}

.hero-highlights div{
    display:grid;
    grid-template-columns:25px 1fr;
    column-gap:8px;
}

.hero-highlights strong{
    grid-row:1 / 3;
    font-size:11px;
    color:#4ec7cc;
}

.hero-highlights span{
    font-size:9px;
    font-weight:700;
    letter-spacing:1px;
}

.hero-highlights small{
    font-size:10px;
    color:rgba(255,255,255,.7);
}


/* ABOUT */

.about{
    background:var(--cream);
}

.about-grid{
    display:grid;
    grid-template-columns:220px 1fr;
    gap:70px;
}

.section-label span{
    font-size:10px;
    font-weight:700;
    letter-spacing:3px;
}

.label-line{
    width:35px;
    height:2px;
    background:var(--teal);
    margin-top:15px;
}

.about-copy{
    max-width:760px;
}

.about-copy h2,
.center-heading h2,
.destination-copy h2,
.booking h2,
.contact h2{
    font-family:"Playfair Display",serif;
    font-weight:500;
    line-height:1.03;
}

.about-copy h2{
    font-size:clamp(48px,5vw,72px);
    margin-bottom:35px;
}

.about-copy h2 em{
    color:var(--teal);
}

.large-copy{
    font-family:"Playfair Display",serif;
    font-size:25px;
    line-height:1.4;
    margin-bottom:20px;
}

.about-copy p{
    max-width:700px;
    margin-bottom:18px;
    color:#506568;
}


/* STAYS */

.stays{
    background:#fff;
}

.center-heading{
    text-align:center;
    max-width:800px;
    margin:0 auto 55px;
}

.center-heading h2{
    font-size:clamp(44px,5vw,66px);
    margin:10px 0 15px;
}

.center-heading>p:last-child{
    color:var(--muted);
}

.property-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:28px;
}

.property-card{
    background:var(--cream);
}

.property-image{
    height:420px;
    position:relative;
    overflow:hidden;
}

.property-image img{
    height:100%;
    object-fit:cover;
    transition:transform .5s ease;
}

.property-card:hover .property-image img{
    transform:scale(1.04);
}

.property-tag{
    position:absolute;
    left:20px;
    top:20px;
    background:rgba(8,63,70,.9);
    color:#fff;
    padding:8px 11px;
    font-size:9px;
    font-weight:700;
    letter-spacing:1.5px;
}

.property-content{
    padding:27px 28px 30px;
}

.property-location{
    font-size:9px;
    letter-spacing:2px;
    color:var(--teal);
    font-weight:700;
    margin-bottom:5px;
}

.property-content h3{
    font-family:"Playfair Display",serif;
    font-size:34px;
    font-weight:500;
    margin-bottom:10px;
}

.property-content>p:not(.property-location){
    color:var(--muted);
    margin-bottom:23px;
}

.property-buttons{
    display:flex;
    gap:9px;
    flex-wrap:wrap;
}

.booking-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:12px 16px;
    color:#fff;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.4px;
}

.booking-btn span{
    font-size:15px;
}

.airbnb{
    background:#ff5a5f;
}

.vrbo{
    background:#153f88;
}


/* FULL WIDTH IMAGE */

.island-video{
    height:650px;
    position:relative;
    overflow:hidden;
}

.island-video>img{
    height:100%;
    object-fit:cover;
}

.island-video-overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding-left:max(24px,calc((100vw - 1180px)/2));
    color:#fff;
    background:linear-gradient(90deg,rgba(2,25,31,.72),rgba(2,25,31,.08));
}

.island-video-overlay p{
    font-size:11px;
    letter-spacing:3px;
    font-weight:700;
    color:#42c2c7;
    margin-bottom:15px;
}

.island-video-overlay h2{
    font-family:"Playfair Display",serif;
    font-size:clamp(48px,6vw,80px);
    line-height:1;
    font-weight:500;
}


/* EXPERIENCE */

.experience{
    background:#fff;
}

.experience-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:22px;
}

.experience-card{
    min-width:0;
}

.experience-image{
    height:300px;
    overflow:hidden;
}

.experience-image img{
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.experience-card:hover img{
    transform:scale(1.04);
}

.experience-content{
    padding:16px 0 0;
}

.experience-content span{
    font-size:10px;
    color:var(--teal);
    letter-spacing:2px;
}

.experience-content h3{
    font-family:"Playfair Display",serif;
    font-size:24px;
    font-weight:500;
    margin:3px 0 5px;
}

.experience-content p{
    color:var(--muted);
    font-size:13px;
}


/* DESTINATION */

.destination{
    display:grid;
    grid-template-columns:1fr 1fr;
    min-height:600px;
    background:#e6f0ee;
}

.destination-image{
    min-height:600px;
}

.destination-image img{
    height:100%;
    object-fit:cover;
}

.destination-copy{
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:80px max(40px,8vw);
}

.destination-copy h2{
    font-size:clamp(48px,5vw,70px);
    margin:12px 0 25px;
}

.destination-copy>p:not(.eyebrow){
    color:#53686a;
    max-width:560px;
    margin-bottom:18px;
}

.text-button{
    display:inline-flex;
    align-items:center;
    gap:10px;
    width:max-content;
    margin-top:12px;
    color:var(--teal-dark);
    font-size:11px;
    font-weight:700;
    letter-spacing:1px;
}


/* BOOKING */

.booking{
    background:var(--deep);
    color:#fff;
    padding:75px 0;
}

.booking-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:50px;
}

.booking .eyebrow{
    color:#42c2c7;
}

.booking h2{
    font-size:clamp(42px,5vw,62px);
    margin:8px 0 12px;
}

.booking p{
    color:rgba(255,255,255,.7);
    max-width:500px;
}

.booking-buttons{
    display:flex;
    gap:12px;
    flex-shrink:0;
}

.big-book{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    min-width:190px;
    padding:17px 22px;
    color:#fff;
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.5px;
}

.big-book span{
    font-size:18px;
}


/* CONTACT */

.contact{
    padding:110px 0;
    text-align:center;
    background:#edf4f1;
}

.contact h2{
    font-size:clamp(48px,5vw,70px);
    margin:10px 0 20px;
}

.contact>div>p:not(.eyebrow){
    max-width:600px;
    margin:0 auto 25px;
    color:var(--muted);
}

.contact-link{
    font-weight:700;
    color:var(--teal-dark);
}


/* FOOTER */

footer{
    background:#052d33;
    color:#fff;
    padding:65px 0 25px;
}

.footer-main{
    width:min(1180px,calc(100% - 48px));
    margin:auto;
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1.3fr;
    gap:45px;
}

.footer-brand p{
    color:rgba(255,255,255,.65);
    max-width:250px;
    font-size:13px;
    margin-top:18px;
}

.footer-column{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.footer-column h4{
    font-size:10px;
    letter-spacing:2px;
    color:#43c1c6;
    margin-bottom:7px;
}

.footer-column a,
.footer-column span{
    font-size:12px;
    color:rgba(255,255,255,.72);
}

.footer-column a:hover{
    color:#fff;
}

.footer-bottom{
    width:min(1180px,calc(100% - 48px));
    margin:45px auto 0;
    padding-top:20px;
    border-top:1px solid rgba(255,255,255,.12);
    display:flex;
    justify-content:space-between;
    color:rgba(255,255,255,.45);
    font-size:11px;
}


/* MOBILE */

@media(max-width:950px){

    #site-header{
        padding:18px 22px;
    }

    .desktop-nav,
    .header-book{
        display:none;
    }

    .menu-toggle{
        display:block;
    }

    .mobile-menu{
        position:absolute;
        top:100%;
        left:0;
        width:100%;
        background:var(--deep);
        padding:22px;
        flex-direction:column;
        gap:16px;
    }

    .mobile-menu.open{
        display:flex;
    }

    .mobile-menu a{
        color:#fff;
        font-size:14px;
    }

    .mobile-book{
        display:block;
        text-align:center;
        background:#fff;
        color:var(--deep)!important;
        padding:13px;
        margin-top:5px;
    }

    .hero-highlights{
        display:none;
    }

    .hero-content{
        padding-top:70px;
    }

    .property-grid{
        grid-template-columns:1fr;
    }

    .experience-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .destination{
        grid-template-columns:1fr;
    }

    .destination-image{
        min-height:450px;
    }

    .booking-inner{
        flex-direction:column;
        align-items:flex-start;
    }

    .footer-main{
        grid-template-columns:repeat(2,1fr);
    }
}


@media(max-width:600px){

    .section{
        padding:80px 0;
    }

    .section-container,
    .hero-content,
    .hero-highlights{
        width:calc(100% - 32px);
    }

    .hero{
        min-height:760px;
    }

    .hero h1{
        font-size:52px;
    }

    .hero-description{
        font-size:15px;
    }

    .hero-actions{
        flex-direction:column;
        align-items:stretch;
    }

    .btn{
        width:100%;
    }

    .about-grid{
        grid-template-columns:1fr;
        gap:25px;
    }

    .about-copy h2{
        font-size:46px;
    }

    .property-image{
        height:320px;
    }

    .property-content h3{
        font-size:30px;
    }

    .island-video{
        height:500px;
    }

    .island-video-overlay{
        padding:30px 20px;
    }

    .experience-grid{
        grid-template-columns:1fr;
    }

    .experience-image{
        height:280px;
    }

    .destination-image{
        min-height:350px;
    }

    .destination-copy{
        padding:70px 24px;
    }

    .booking-inner{
        width:calc(100% - 32px);
    }

    .booking-buttons{
        width:100%;
        flex-direction:column;
    }

    .big-book{
        width:100%;
    }

    .footer-main{
        grid-template-columns:1fr;
    }

    .footer-bottom{
        flex-direction:column;
        gap:5px;
        text-align:center;
    }
}

/* PUPPY OFFER */

.puppy-offer {
    padding: 110px 24px;
    background: #f3eee5;
}

.puppy-offer-inner {
    max-width: 1180px;
    min-height: 430px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    align-items: center;
    gap: 60px;
    position: relative;
    overflow: hidden;
}

.puppy-offer-content {
    max-width: 650px;
    position: relative;
    z-index: 2;
}

.puppy-offer .eyebrow {
    margin-bottom: 0;
}

.puppy-offer h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -2px;
    margin: 18px 0 28px;
    color: #123e44;
}

.puppy-offer p:not(.eyebrow) {
    max-width: 570px;
    font-size: 18px;
    line-height: 1.8;
    color: #536769;
    margin: 0 0 32px;
}

.puppy-offer p strong {
    color: #123e44;
}

.puppy-offer-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 24px;
    background: #123e44;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .04em;
    transition: transform .2s ease, background .2s ease;
}

.puppy-offer-button:hover {
    transform: translateY(-2px);
    background: #082b30;
}

.puppy-offer-art {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: #e4d7c4;
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
}

.puppy-offer-art span {
    font-size: 90px;
    line-height: 1;
    transform: rotate(-12deg);
}

@media (max-width: 768px) {

    .puppy-offer {
        padding: 75px 20px;
    }

    .puppy-offer-inner {
        display: block;
        min-height: 0;
    }

    .puppy-offer h2 {
        font-size: 46px;
        letter-spacing: -1px;
    }

    .puppy-offer p:not(.eyebrow) {
        font-size: 16px;
    }

    .puppy-offer-art {
        width: 190px;
        height: 190px;
        margin: 50px auto 0;
    }

    .puppy-offer-art span {
        font-size: 60px;
    }
}

