@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap');

:root {
    --navy:#123e44;
    --deep:#082b30;
    --sand:#f3eee5;
    --cream:#faf9f5;
    --white:#fff;
    --muted:#68797a;
    --line:#dfe4e1;
}

* {
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html {
    scroll-behavior:smooth;
}

body {
    font-family:"DM Sans",Arial,sans-serif;
    color:var(--navy);
    background:var(--cream);
    line-height:1.7;
}

a {
    color:inherit;
    text-decoration:none;
}

img,
video {
    display:block;
    width:100%;
}

.container {
    width:min(1180px,calc(100% - 48px));
    margin:auto;
}

.site-header {
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:100;
    color:#fff;
    transition:.35s ease;
}

.site-header.scrolled {
    background:rgba(8,43,48,.96);
    box-shadow:0 5px 30px rgba(0,0,0,.12);
}

.nav-wrap {
    width:min(1320px,calc(100% - 56px));
    margin:auto;
    height:88px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:35px;
}

.brand {
    display:flex;
    flex-direction:column;
    line-height:1;
    letter-spacing:.16em;
    font-size:13px;
}

.brand span {
    font-size:9px;
    margin-bottom:5px;
    letter-spacing:.32em;
    opacity:.8;
}

.brand strong {
    font-weight:500;
}

.desktop-nav {
    display:flex;
    gap:36px;
    margin-left:auto;
}

.desktop-nav a {
    font-size:13px;
    transition:.2s;
}

.desktop-nav a:hover {
    opacity:.65;
}

.nav-book {
    border:1px solid rgba(255,255,255,.7);
    padding:11px 18px;
    font-size:12px;
    letter-spacing:.04em;
    transition:.25s;
}

.nav-book:hover {
    background:#fff;
    color:var(--navy);
}

.menu-toggle {
    display:none;
    background:none;
    border:0;
    width:30px;
}

.menu-toggle i {
    display:block;
    height:1px;
    background:#fff;
    margin:6px 0;
}

.mobile-menu {
    display:none;
}

.hero {
    height:100vh;
    min-height:680px;
    position:relative;
    color:#fff;
    overflow:hidden;
}

.hero-video {
    position:absolute;
    inset:0;
    height:100%;
    object-fit:cover;
}

.hero-overlay {
    position:absolute;
    inset:0;
    background:linear-gradient(90deg,rgba(4,29,33,.68),rgba(4,29,33,.15) 70%,rgba(4,29,33,.15));
}

.hero-inner {
    position:absolute;
    left:max(24px,calc((100% - 1180px)/2));
    top:50%;
    transform:translateY(-43%);
    max-width:720px;
}

.eyebrow {
    font-size:11px;
    letter-spacing:.22em;
    font-weight:600;
    margin-bottom:18px;
}

.hero-eyebrow {
    color:#dcebea;
}

.hero h1 {
    font-family:"Playfair Display",serif;
    font-weight:500;
    font-size:clamp(54px,7vw,96px);
    line-height:.98;
    letter-spacing:-.035em;
    margin-bottom:28px;
}

.hero-text {
    max-width:530px;
    font-size:17px;
    color:rgba(255,255,255,.9);
}

.hero-buttons {
    display:flex;
    gap:12px;
    margin-top:35px;
}

.btn {
    display:inline-block;
    padding:15px 24px;
    font-size:12px;
    font-weight:600;
    letter-spacing:.05em;
    transition:.25s;
}

.btn-light {
    background:#fff;
    color:var(--navy);
}

.btn-light:hover {
    background:var(--sand);
}

.btn-outline {
    border:1px solid rgba(255,255,255,.8);
}

.btn-outline:hover {
    background:#fff;
    color:var(--navy);
}

.hero-bottom {
    position:absolute;
    bottom:34px;
    left:50%;
    transform:translateX(-50%);
    display:flex;
    align-items:center;
    gap:15px;
    font-size:9px;
    letter-spacing:.2em;
    opacity:.8;
}

.scroll-line {
    width:60px;
    height:1px;
    background:#fff;
}

.section {
    padding:125px 0;
}

.intro {
    background:var(--cream);
}

.intro-grid,
.destination-grid,
.contact-inner {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:100px;
}

h2 {
    font-family:"Playfair Display",serif;
    font-size:clamp(42px,5vw,66px);
    line-height:1.02;
    font-weight:500;
    letter-spacing:-.035em;
}

.intro-copy {
    max-width:520px;
    padding-top:35px;
}

.intro-copy .lead,
.section-top > p,
.destination-copy .lead {
    font-size:21px;
    line-height:1.55;
}

.intro-copy p:not(.lead) {
    color:var(--muted);
    margin-top:20px;
}

.text-link {
    display:inline-block;
    margin-top:25px;
    font-size:12px;
    font-weight:600;
    border-bottom:1px solid currentColor;
    padding-bottom:4px;
}

.wide-image {
    height:620px;
    overflow:hidden;
}

.wide-image img {
    height:100%;
    object-fit:cover;
}

.stays {
    background:var(--sand);
}

.section-top {
    display:grid;
    grid-template-columns:1fr 380px;
    gap:80px;
    align-items:end;
    margin-bottom:60px;
}

.section-top > p {
    color:var(--muted);
    font-size:16px;
}

.stay-grid {
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:28px;
}

.stay-card {
    background:#fff;
}

.stay-photo {
    height:430px;
    position:relative;
    overflow:hidden;
}

.stay-photo img {
    height:100%;
    object-fit:cover;
    transition:transform .7s ease;
}

.stay-card:hover .stay-photo img {
    transform:scale(1.04);
}

.stay-photo span {
    position:absolute;
    left:20px;
    bottom:20px;
    color:#fff;
    background:rgba(8,43,48,.85);
    padding:8px 12px;
    font-size:9px;
    letter-spacing:.15em;
}

.stay-content {
    padding:32px;
}

.small-label {
    font-size:10px;
    letter-spacing:.18em;
    color:#718181;
    margin-bottom:9px;
}

.stay-content h3 {
    font-family:"Playfair Display",serif;
    font-size:34px;
    font-weight:500;
    margin-bottom:12px;
}

.stay-content > p:not(.small-label) {
    color:var(--muted);
    font-size:14px;
}

.card-links {
    display:flex;
    gap:22px;
    margin-top:25px;
}

.card-links a {
    font-size:12px;
    font-weight:600;
    border-bottom:1px solid var(--navy);
    padding-bottom:4px;
}

.card-links b {
    font-weight:400;
}

.experience {
    height:720px;
    position:relative;
    color:#fff;
    overflow:hidden;
}

.experience > video {
    position:absolute;
    inset:0;
    height:100%;
    object-fit:cover;
}

.experience-overlay {
    position:absolute;
    inset:0;
    background:rgba(6,34,38,.42);
}

.experience-content {
    position:absolute;
    left:max(24px,calc((100% - 1180px)/2));
    bottom:90px;
}

.experience-content h2 {
    font-size:clamp(48px,6vw,80px);
}

.experiences {
    background:#fff;
}

.experience-grid {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.experience-card {
    background:var(--sand);
}

.experience-card img {
    height:260px;
    object-fit:cover;
}

.experience-card div {
    padding:25px;
}

.experience-card span {
    font-size:10px;
    color:#788786;
}

.experience-card h3 {
    font-family:"Playfair Display",serif;
    font-size:28px;
    font-weight:500;
    margin:8px 0;
}

.experience-card p {
    color:var(--muted);
    font-size:14px;
}

.destination {
    background:var(--cream);
}

.destination-image {
    height:650px;
}

.destination-image img {
    height:100%;
    object-fit:cover;
}

.destination-copy {
    align-self:center;
    max-width:500px;
}

.destination-copy .lead {
    margin-top:28px;
}

.destination-copy > p:not(.lead) {
    color:var(--muted);
    margin-top:22px;
}

.booking {
    background:var(--deep);
    color:#fff;
    padding:120px 0;
    text-align:center;
}

.booking-inner {
    max-width:850px;
}

.booking h2 {
    font-size:clamp(45px,6vw,72px);
}

.booking-inner > p:not(.eyebrow) {
    color:rgba(255,255,255,.7);
    max-width:560px;
    margin:25px auto 0;
}

.booking-buttons {
    display:flex;
    justify-content:center;
    gap:14px;
    margin-top:38px;
}

.booking-button {
    min-width:205px;
    padding:16px 22px;
    border:1px solid rgba(255,255,255,.35);
    display:flex;
    justify-content:space-between;
    gap:35px;
    transition:.25s;
    font-size:12px;
    font-weight:600;
}

.booking-button:hover {
    background:#fff;
    color:var(--navy);
}

.contact {
    background:var(--sand);
}

.contact-inner {
    align-items:center;
}

.contact-inner > div:last-child {
    max-width:500px;
    color:var(--muted);
}

footer {
    background:#071f23;
    color:#fff;
}

.footer-main {
    padding:70px 0;
    display:flex;
    justify-content:space-between;
    gap:50px;
}

.footer-brand {
    margin-bottom:20px;
}

.footer-main p {
    color:rgba(255,255,255,.55);
    font-size:13px;
}

.footer-links {
    display:flex;
    flex-direction:column;
    gap:9px;
    font-size:12px;
}

.footer-links a {
    color:rgba(255,255,255,.7);
}

.footer-bottom {
    border-top:1px solid rgba(255,255,255,.1);
    padding:22px 0;
    color:rgba(255,255,255,.4);
    font-size:10px;
}

@media(max-width:800px) {

    .container {
        width:min(100% - 32px,1180px);
    }

    .desktop-nav,
    .nav-book {
        display:none;
    }

    .menu-toggle {
        display:block;
    }

    .mobile-menu {
        display:none;
        background:var(--deep);
        padding:15px 25px 25px;
    }

    .mobile-menu.open {
        display:flex;
        flex-direction:column;
    }

    .mobile-menu a {
        padding:13px 0;
        border-bottom:1px solid rgba(255,255,255,.1);
    }

    .mobile-book {
        margin-top:12px;
        background:#fff;
        color:var(--navy);
        text-align:center;
        padding:13px!important;
    }

    .hero {
        min-height:650px;
    }

    .hero-inner {
        left:20px;
        right:20px;
    }

    .hero h1 {
        font-size:52px;
    }

    .hero-text {
        font-size:15px;
    }

    .hero-buttons {
        flex-direction:column;
        max-width:260px;
    }

    .btn {
        text-align:center;
    }

    .section {
        padding:80px 0;
    }

    .intro-grid,
    .destination-grid,
    .contact-inner,
    .section-top {
        grid-template-columns:1fr;
        gap:35px;
    }

    .intro-copy {
        padding-top:0;
    }

    .wide-image {
        height:400px;
    }

    .stay-grid,
    .experience-grid {
        grid-template-columns:1fr;
    }

    .stay-photo {
        height:330px;
    }

    .experience {
        height:570px;
    }

    .destination-image {
        height:430px;
        order:2;
    }

    .booking {
        padding:85px 0;
    }

    .booking-buttons {
        flex-direction:column;
    }

    .booking-button {
        width:100%;
    }

    .footer-main {
        flex-direction:column;
        padding:55px 0;
    }
}
